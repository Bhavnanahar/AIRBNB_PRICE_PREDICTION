body {
    font-family: Arial, sans-serif;
    background: #f7f7f7;
    text-align: center;
    padding-top: 50px;
}

.container {
    background: white;
    padding: 30px;
    margin: auto;
    width: 400px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

input, select, button {
    width: 90%;
    padding: 10px;
    margin: 10px 0;
}

button {
    background-color: #007BFF;
    color: white;
    border: none;
}
